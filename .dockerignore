# Keep the build context small and secrets out of the image.
.git
.github
.claude
.venv
data/
*.db
*.db-journal
*.db-wal
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Design reference, not runtime code.
design_handoff_nyhetsradar/

# The Next.js frontend is a separate deployable and is not part of the Flask
# API image. Without this the build context would include node_modules and
# .next — tens of thousands of files sent to the daemon for nothing.
web/

tests/
.DS_Store
*.md
!README.md
