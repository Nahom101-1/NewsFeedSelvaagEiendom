# Copy to .env and fill in. Never commit .env.

# Required from MVP step 5 (scoring) onward.
ANTHROPIC_API_KEY=sk-ant-...

# Flask
FLASK_SECRET_KEY=change-me
FLASK_ENV=development

# Storage
DATABASE_PATH=data/news.db

# Dashboard basic auth (Caddy reads these in production)
DASHBOARD_USER=selvaag
DASHBOARD_PASSWORD_HASH=

# ── Production deploy (compose.prod.yaml) ────────────────────────────────────
# Domain Caddy requests a certificate for. Must already point at the VM.
DOMAIN=radar.example.no
# Shared login for testers.
BASIC_AUTH_USER=radar
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'pw'
BASIC_AUTH_HASH=
# Seconds between collection cycles (14400 = 4 hours).
COLLECT_INTERVAL=14400
# Set to --llm to enable Haiku summaries (needs ANTHROPIC_API_KEY above).
SCORE_ARGS=
